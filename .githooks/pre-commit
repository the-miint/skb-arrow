#!/usr/bin/env bash
# Pre-commit gate: lint, format, type-check and test must all pass.
# CI runs this file too; keep it the full gate.
# Enable with:  git config core.hooksPath .githooks
set -euo pipefail
# The gate tests this checkout's host; install.yml sets it to a published one's.
unset SKB_ARROW_BIN

echo "pre-commit: ruff check"
uv run --locked ruff check .

echo "pre-commit: ruff format --check"
uv run --locked ruff format --check .

echo "pre-commit: mypy"
uv run --locked mypy

echo "pre-commit: pytest"
uv run --locked pytest -q

echo "pre-commit: all checks passed"
